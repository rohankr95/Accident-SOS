# Copy this file to .env and fill in real values.

# Port the server listens on.
PORT=3000

# Public URL of this app, used to build the SOS link encoded in QR codes.
# Must be reachable by whoever scans the QR code (use ngrok/a real domain in production).
PUBLIC_BASE_URL=http://localhost:3000

# --- Twilio (optional) ---
# If left unset, SMS/calls are simulated (logged to the console) so you can
# test the full flow without a paid account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Nearest-services lookup (OpenStreetMap Overpass API, free & keyless) ---
OVERPASS_URL=https://overpass-api.de/api/interpreter
SEARCH_RADIUS_M=8000
